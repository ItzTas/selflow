warning-title = Daqui a pouco: { $label }
warning-body-1 = { $minutes ->
    [one] A tela bloqueia em um minuto ({ $time }).
   *[other] A tela bloqueia em { $minutes } minutos ({ $time }).
}
warning-body-2 = { $minutes ->
    [one] Falta um minuto para o bloqueio ({ $time }). Um bom momento para salvar o que está aberto.
   *[other] Faltam { $minutes } minutos para o bloqueio ({ $time }). Um bom momento para ir encerrando.
}
warning-body-3 = { $minutes ->
    [one] Em cerca de um minuto a tela bloqueia ({ $time }). Salve o que estiver aberto.
   *[other] Em cerca de { $minutes } minutos a tela bloqueia ({ $time }). Você já pode ir desacelerando.
}
