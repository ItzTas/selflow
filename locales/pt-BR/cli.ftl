cli-daemon-unreachable = O Selflow não está rodando agora. Para iniciá-lo, rode: systemctl --user start selflowd.service
cli-no-runtime-dir = O Selflow não encontrou sua pasta de execução. Confira se XDG_RUNTIME_DIR está definido.
cli-protocol-error = A conversa com o Selflow foi interrompida. Nada foi alterado.
cli-editor-failed = Seu editor não terminou direito, então nada foi salvo.
cli-unexpected-response = O Selflow respondeu de um jeito que este comando não entende.
cli-version-mismatch = Os programas do Selflow não combinam. Este comando usa o protocolo { $client }, o daemon em execução usa { $running } e o instalado usa { $installed }. Reinstale o Selflow para corrigir: make install
cli-error-line = linha { $line }, coluna { $column }: { $text }
cli-edit-again = Editar de novo? [S/n]
cli-config-unchanged = Nada mudou, então nada foi salvo.
cli-config-abandoned = Nada foi salvo. Suas configurações continuam como estavam.
cli-saved = Salvo.
cli-saved-now = Vale agora:
cli-saved-later = Aguarda até { $when }:
cli-saved-nothing = Nada muda no funcionamento das suas regras.
cli-status-default = Nenhuma regra roda até você salvar suas configurações pela primeira vez. Para salvá-las, rode selflow config edit.
cli-status-last-saved = Suas configurações foram salvas pela última vez em { $when }.
cli-status-no-pending = Nenhuma mudança está aguardando.
cli-status-pending = Aguarda até { $when }:
cli-report-heading = Relatório de { $date }
cli-report-empty = Nada a relatar neste dia.
cli-report-waiting = Mudanças ainda aguardando:
cli-report-waiting-line = { $when }  { $text }
cli-test-lock-started = Bloqueio de teste "{ $label }" até { $time }.
cli-unlock-wait = Você pode pedir mais tempo a partir das { $time }.
cli-unlock-granted = Desbloqueado até { $time }.
cli-unlock-not-locked = Nada está bloqueado agora. Se a tela ainda parecer bloqueada, ela libera em instantes.
cli-exception-wait = Você pode pular a regra { $label } a partir das { $time }.
cli-exception-reason = Por que pular hoje?
cli-exception-granted = A regra { $label } fica de fora pelo resto do dia.
cli-exception-no-budget = A regra { $label } não tem mais extensões hoje, e pular a regra precisa de uma.
cli-claude-changes = O Selflow vai fazer estas mudanças em { $path }:
cli-claude-confirm = Salvar estas mudanças? [s/N]
cli-claude-written = { $path } salvo.
cli-claude-unchanged = Nada a mudar em { $path }.
cli-claude-declined = Nada foi salvo. { $path } continua como estava.
cli-claude-invalid-file = { $path } não é um JSON válido, então o Selflow não mexeu nele: { $detail }
cli-claude-file-failed = O Selflow não conseguiu ler ou gravar { $path }: { $detail }
cli-claude-no-settings-path = O Selflow não encontrou suas configurações do Claude Code. Defina HOME ou CLAUDE_CONFIG_DIR.
cli-claude-no-program-path = O Selflow não encontrou o caminho do próprio programa, então não tem o que colocar nos hooks.
cli-claude-missing = O Selflow não conseguiu ler a versão do seu Claude Code com claude --version. Lembretes e ferramentas bloqueadas funcionam em qualquer versão, mas mensagens para uma sessão ociosa precisam da { $min } ou mais recente.
cli-claude-too-old = Você tem o Claude Code { $found }. Lembretes e ferramentas bloqueadas funcionam, mas mensagens para uma sessão ociosa precisam da { $min } ou mais recente.
cli-claude-held = Suas configurações do Claude Code definem crossSessionInbound como "{ $value }", então as mensagens do Selflow esperam sua aprovação ou nunca chegam. Defina como "accept" para recebê-las.
cli-claude-bypassed = O Claude Code roda com bypassPermissions, então segura as mensagens de outras sessões, inclusive as do Selflow, até você aprová-las. Defina crossSessionInbound como "accept" para recebê-las na hora.
cli-moment = { $weekday } { $day } { $month }, { $time }

