cli-daemon-unreachable = O Selflow não está rodando agora. Para iniciá-lo, rode: systemctl --user start selflowd.service
cli-no-runtime-dir = O Selflow não encontrou sua pasta de execução. Confira se XDG_RUNTIME_DIR está definido.
cli-protocol-error = A conversa com o Selflow foi interrompida. Nada foi alterado.
cli-editor-failed = Seu editor não terminou direito, então nada foi salvo.
cli-unexpected-response = O Selflow respondeu de um jeito que este comando não entende.
cli-error-line = linha { $line }, coluna { $column }: { $text }
cli-edit-again = Editar de novo? [S/n]
cli-config-unchanged = Nada mudou, então nada foi salvo.
cli-config-abandoned = Nada foi salvo. Suas configurações continuam como estavam.
cli-saved-tighten = Salvo. Isso deixa as regras mais firmes, então vale agora.
cli-saved-loosen = Salvo. Isso afrouxa suas configurações, então passa a valer em { $when }.
cli-saved-neutral = Salvo.
cli-status-default = Você está usando as configurações padrão.
cli-status-in-force = As configurações em vigor foram salvas em { $when }.
cli-status-no-pending = Nenhuma mudança está aguardando.
cli-status-pending = Uma mudança está aguardando e passa a valer em { $when }:
cli-report-heading = Relatório de { $date }
cli-report-empty = Nada a relatar neste dia.
cli-moment = { $weekday } { $day } { $month }, { $time }

