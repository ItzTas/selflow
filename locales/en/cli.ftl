cli-daemon-unreachable = Selflow isn't running right now. To start it, run: systemctl --user start selflowd.service
cli-no-runtime-dir = Selflow couldn't find your runtime folder. Check that XDG_RUNTIME_DIR is set.
cli-protocol-error = The conversation with Selflow was interrupted. Nothing was changed.
cli-editor-failed = Your editor didn't finish cleanly, so nothing was saved.
cli-unexpected-response = Selflow answered in a way this command doesn't understand.
cli-version-mismatch = The Selflow programs don't match. This command uses protocol { $client }, the running daemon uses { $running } and the installed one uses { $installed }. Reinstall Selflow to fix it: make install
cli-error-line = line { $line }, column { $column }: { $text }
cli-edit-again = Edit again? [Y/n]
cli-config-unchanged = Nothing changed, so nothing was saved.
cli-config-abandoned = Nothing was saved. Your settings are as they were.
cli-saved = Saved.
cli-saved-now = Applies now:
cli-saved-later = Waits until { $when }:
cli-saved-nothing = Nothing changes in how your rules work.
cli-status-default = No rule runs until you save your settings for the first time. To save them, run selflow config edit.
cli-status-last-saved = Your settings were last saved on { $when }.
cli-status-no-pending = No changes are waiting.
cli-status-pending = Waits until { $when }:
cli-report-heading = Report for { $date }
cli-report-empty = Nothing to report for this day.
cli-report-waiting = Changes still waiting:
cli-report-waiting-line = { $when }  { $text }
cli-test-lock-started = Test lock "{ $label }" until { $time }.
cli-unlock-wait = You can ask for more time from { $time }.
cli-unlock-granted = Unlocked until { $time }.
cli-unlock-not-locked = Nothing is locked right now. If the screen still looks locked, it clears in a moment.
cli-exception-wait = You can skip the { $label } rule from { $time }.
cli-exception-reason = Why skip it today?
cli-exception-granted = The { $label } rule is off for the rest of the day.
cli-exception-no-budget = The { $label } rule has no extensions left today, and skipping it needs one.
cli-moment = { $weekday } { $day } { $month }, { $time }

weekday-short-mon = Mon
weekday-short-tue = Tue
weekday-short-wed = Wed
weekday-short-thu = Thu
weekday-short-fri = Fri
weekday-short-sat = Sat
weekday-short-sun = Sun

month-short-1 = Jan
month-short-2 = Feb
month-short-3 = Mar
month-short-4 = Apr
month-short-5 = May
month-short-6 = Jun
month-short-7 = Jul
month-short-8 = Aug
month-short-9 = Sep
month-short-10 = Oct
month-short-11 = Nov
month-short-12 = Dec
