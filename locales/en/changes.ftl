change-lock-added = The lock `{ $rule }` now applies on { $days }.
change-lock-removed = The lock `{ $rule }` no longer applies on { $days }.
change-lock-starts-earlier = The lock `{ $rule }` starts earlier on { $days }: { $old } → { $new }.
change-lock-starts-later = The lock `{ $rule }` starts later on { $days }: { $old } → { $new }.
change-lock-ends-later = The lock `{ $rule }` ends later on { $days }: { $old } → { $new }.
change-lock-ends-earlier = The lock `{ $rule }` ends earlier on { $days }: { $old } → { $new }.
change-shutdown-added = On { $days }, the computer shuts down when the lock `{ $rule }` has lasted { $new }.
change-shutdown-removed = On { $days }, the lock `{ $rule }` no longer shuts the computer down after { $old }.
change-shutdown-sooner = On { $days }, the lock `{ $rule }` shuts the computer down sooner: { $old } → { $new }.
change-shutdown-later = On { $days }, the lock `{ $rule }` shuts the computer down later: { $old } → { $new }.
change-warnings = The notices before the lock `{ $rule }` change on { $days }: { $old } → { $new }.
change-label = The name shown for the lock `{ $rule }` changes on { $days }: { $old } → { $new }.
change-wait-longer = In the rule set `{ $rule }`, the wait before unlocking gets longer on { $days }: { $old } → { $new }.
change-wait-shorter = In the rule set `{ $rule }`, the wait before unlocking gets shorter on { $days }: { $old } → { $new }.
change-reason-required = In the rule set `{ $rule }`, unlocking asks for a written reason on { $days }.
change-reason-dropped = In the rule set `{ $rule }`, unlocking no longer asks for a written reason on { $days }.
change-phrase-added = In the rule set `{ $rule }`, unlocking asks you to type a sentence on { $days }: { $new }
change-phrase-dropped = In the rule set `{ $rule }`, unlocking no longer asks you to type a sentence on { $days }.
change-phrase-changed = In the rule set `{ $rule }`, the sentence to type changes on { $days }: { $old } → { $new }
change-fewer-extensions = In the rule set `{ $rule }`, each night allows fewer extensions on { $days }: { $old } → { $new }.
change-more-extensions = In the rule set `{ $rule }`, each night allows more extensions on { $days }: { $old } → { $new }.
change-shorter-extensions = In the rule set `{ $rule }`, each extension gets shorter on { $days }: { $old } → { $new }.
change-longer-extensions = In the rule set `{ $rule }`, each extension gets longer on { $days }: { $old } → { $new }.
change-day-start = The day starts at a different time: { $old } → { $new }.
change-delay-longer = Changes that loosen the rules wait longer before they take effect: { $old } → { $new }.
change-delay-shorter = Changes that loosen the rules wait less before they take effect: { $old } → { $new }.
change-language = The language changes: { $old } → { $new }.
